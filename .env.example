SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Web Push server secrets: set these in Vercel Production, never in browser code.
# Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# daily = fixed20:00 Vietnam with daily Hobby cron; flexible requires15min scheduler.
PUSH_SCHEDULE_MODE=daily
PUSH_REDIS_PREFIX=tutu:push:v1
# Existing Vercel KV REST aliases are also accepted instead of UPSTASH_*:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
